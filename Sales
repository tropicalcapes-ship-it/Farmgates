const cart={};

function renderProducts(){
  document.getElementById("products").innerHTML=products.map((p,i)=>`
  <article class="card ${i<4?'featured':''}">
    <img src="${p.img}" alt="${p.name}" loading="lazy">
    <div class="card-body">
      <div class="tag">${p.cat}</div>
      <h3>${p.name}</h3>
      <div class="price">$${p.price.toFixed(2)}</div>
      <div class="desc">${p.desc}</div>
      <button class="add" onclick="addToCart(${i})">Add to order</button>
    </div>
  </article>`).join("");
  updateCart();
}
function addToCart(i){cart[i]=(cart[i]||0)+1;updateCart();document.getElementById("cartPanel").style.display="block"}
function changeQty(i,n){cart[i]+=n;if(cart[i]<=0)delete cart[i];updateCart()}
function updateCart(){
  let total=0,count=0;
  const ids=Object.keys(cart);
  document.getElementById("cartItems").innerHTML=ids.length?ids.map(i=>{
    const p=products[i],sub=p.price*cart[i];total+=sub;count+=cart[i];
    return `<div class="cart-row"><div><strong>${p.name}</strong><br><span class="qty">
    <button onclick="changeQty(${i},-1)">−</button> ${cart[i]} <button onclick="changeQty(${i},1)">+</button>
    </span></div><strong>$${sub.toFixed(2)}</strong></div>`;
  }).join(""):"<p>Your cart is empty.</p>";
  document.getElementById("total").textContent=total.toFixed(2);
  document.getElementById("cartCount").textContent=count;
}
function toggleCart(){
  const p=document.getElementById("cartPanel");
  p.style.display=p.style.display==="block"?"none":"block";
}
function sendOrder(e){
  e.preventDefault();
  if(!Object.keys(cart).length){alert("Please add at least one product first.");return}
  const items=Object.keys(cart).map(i=>products[i].name+" x "+cart[i]).join(", ");
  const body=`Hello Farm Fresh,%0A%0AI would like to place an order.%0A%0AName: ${encodeURIComponent(document.getElementById("name").value)}%0APhone/WhatsApp: ${encodeURIComponent(document.getElementById("phone").value)}%0AEmail: ${encodeURIComponent(document.getElementById("email").value)}%0ADelivery address: ${encodeURIComponent(document.getElementById("address").value)}%0AItems: ${encodeURIComponent(items)}%0ATotal: $${document.getElementById("total").textContent}%0ANotes: ${encodeURIComponent(document.getElementById("notes").value)}`;
  window.location.href="mailto:YOUR-EMAIL@example.com?subject=Farm Fresh Order&body="+body;
}
renderProducts();
